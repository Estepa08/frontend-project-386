          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EventTypeInput": {
        "type": "object",
